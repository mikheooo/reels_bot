BOT_TOKEN=your_bot_token_here
EXPECTED_BOT_USERNAME=Reeelsanalyzerbot
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: billing-enabled (paid) key, tried FIRST in rotation (alias=paid in logs).
# Leave unset to keep free-tier only. Free-tier keys remain fallback.
GEMINI_PAID_KEY=your_paid_gemini_api_key_here
DB_URL=postgresql+asyncpg://user:password@postgres:5432/reels_db
REDIS_URL=redis://redis:6379/0
EXA_API_KEY=your_exa_api_key_here
JINA_API_KEY=your_jina_api_key_here
# Priority score bands: LOW < 0.40, AMBIGUOUS 0.40-0.59, HIGH >= 0.60.
PUBLISH_THRESHOLD=0.6
DEPRIORITIZE_THRESHOLD=0.4
PRIORITIZATION_TIMEOUT_SECONDS=120
LANGUAGE_DETECTION_TIMEOUT_SECONDS=2
# Optional evidence-only personalization. If neither is set, relevance is UNKNOWN.
# REELS_PERSONAL_CONTEXT_JSON={"installed_tools":[],"workflows":[]}
# REELS_PERSONAL_CONTEXT_FILE=/config/personal-context.json

# Optional External Platform Connectors (X / Twitter)
# X_API_KEY=your_x_api_key
# X_API_SECRET=your_x_api_secret
# X_ACCESS_TOKEN=your_x_user_access_token
# X_ACCESS_TOKEN_SECRET=your_x_user_token_secret
# EXPECTED_X_USER_ID=your_x_numeric_id
# EXPECTED_X_USERNAME=your_x_handle

# Optional External Platform Connectors (Meta Threads)
# THREADS_ACCESS_TOKEN=your_threads_long_lived_token
# THREADS_USER_ID=your_threads_user_id
# EXPECTED_THREADS_USER_ID=your_threads_user_id

