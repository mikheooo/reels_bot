BOT_TOKEN=your_bot_token_here
EXPECTED_BOT_USERNAME=Reeelsanalyzerbot
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: billing-enabled (paid) key, tried FIRST in rotation (alias=paid in logs).
# Leave unset to keep free-tier only. Free-tier keys remain fallback.
GEMINI_PAID_KEY=your_paid_gemini_api_key_here
DB_URL=postgresql+asyncpg://user:password@postgres:5432/reels_db
REDIS_URL=redis://redis:6379/0
EXA_API_KEY=your_exa_api_key_here
JINA_API_KEY=your_jina_api_key_here
